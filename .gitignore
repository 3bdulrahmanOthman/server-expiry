# Environment
.env
.env.*
!.env.example

# Build artifacts
*.zip
*.tar.gz

# Dependencies
/vendor/
/node_modules/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Composer / NPM caches
# composer.lock is tracked on purpose: CI installs with `composer install` so the
# test job resolves the exact dependency set that was tested, not a fresh one.
# It is a plugin (no runtime dependencies of its own), so the lock only pins the
# dev toolchain (pint, phpunit, and their transitive packages).
package-lock.json
yarn.lock
# PHPUnit
.phpunit.cache/
# Local test tooling (PHPUnit phar)
/tools/

# Local-only artifacts — never commit, never package (H7.3)
# .mcp.json holds a live provider API key.
/.mcp.json
/fe
/database/migrations_recovery/
# Agent execution/planning artifacts (session checkpoints, not release docs)
/tasks/
# Root-level generated screenshots (local QA artifacts)
/expiry-*.png
